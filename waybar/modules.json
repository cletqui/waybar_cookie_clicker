{
  "custom/cookie-clicker": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh --watch --every 1 show",
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh click",
    "on-click-middle": "$HOME/.config/waybar/cookie-clicker/run.sh reset",
    "return-type": "json"
  },
  "custom/cookie-s0": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh --watch --every 1 slot 0",
    "hide-empty-text": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 0",
    "return-type": "json"
  },
  "custom/cookie-s1": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh --watch --every 1 slot 1",
    "hide-empty-text": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 1",
    "return-type": "json"
  },
  "custom/cookie-s2": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh --watch --every 1 slot 2",
    "hide-empty-text": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 2",
    "return-type": "json"
  },
  "custom/cookie-s3": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh --watch --every 1 slot 3",
    "hide-empty-text": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 3",
    "return-type": "json"
  },
  "custom/cookie-s4": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh --watch --every 1 slot 4",
    "hide-empty-text": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 4",
    "return-type": "json"
  },
  "custom/cookie-s5": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh --watch --every 1 slot 5",
    "hide-empty-text": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 5",
    "return-type": "json"
  },
  "custom/cookie-s6": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh --watch --every 1 slot 6",
    "hide-empty-text": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 6",
    "return-type": "json"
  },
  "custom/cookie-s7": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh --watch --every 1 slot 7",
    "hide-empty-text": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 7",
    "return-type": "json"
  },
  "group/group-cookie": {
    "drawer": {
      "click-to-reveal": false,
      "transition-duration": 250,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/cookie-clicker",
      "custom/cookie-s0",
      "custom/cookie-s1",
      "custom/cookie-s2",
      "custom/cookie-s3",
      "custom/cookie-s4",
      "custom/cookie-s5",
      "custom/cookie-s6",
      "custom/cookie-s7"
    ],
    "orientation": "horizontal"
  }
}
