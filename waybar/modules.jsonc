// Cookie Clicker waybar module definitions — annotated template
// ─────────────────────────────────────────────────────────────────────────────
// modules.json  is the ready-to-use version (uses $HOME, waybar expands it).
// This file (modules.jsonc) is the same thing with comments explaining each
// field — kept for documentation purposes. Keep it in sync with modules.json.
//
// Quick setup:
//   1. cargo build --release
//   2. ln -s /path/to/waybar_cookie_clicker/waybar ~/.config/waybar/cookie-clicker
//   3. In config.jsonc, add to "include":
//        "~/.config/waybar/cookie-clicker/modules.json"
//   4. Add "group/group-cookie" to modules-right.
//   5. In style.css, add at the top:
//        @import "cookie-clicker/style.css";
//
// modules.json calls run.sh via the stable symlinked path
// $HOME/.config/waybar/cookie-clicker/run.sh, which resolves back to the
// real repo whether it's symlinked or copied — no path editing needed.
//
// Signal 9 (SIGRTMIN+9) is used for instant refresh after clicks.
// Change all "signal": 9 and SIGRTMIN+9 if it conflicts with another module.

{
  "group/group-cookie": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 250,
      "transition-left-to-right": false,
      "click-to-reveal": false,
    },
    "modules": [
      "custom/cookie-clicker",
      "custom/cookie-s0",
      "custom/cookie-s1",
      "custom/cookie-s2",
      "custom/cookie-s3",
      "custom/cookie-s4",
      "custom/cookie-s5",
      "custom/cookie-s6",
      "custom/cookie-s7",
    ],
  },

  "custom/cookie-clicker": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh show",
    "exec-on-event": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh click; pkill -SIGRTMIN+9 waybar",
    "on-click-middle": "$HOME/.config/waybar/cookie-clicker/run.sh reset; pkill -SIGRTMIN+9 waybar",
    "return-type": "json",
    "interval": 1,
    "signal": 9,
  },

  "custom/cookie-s0": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh slot 0",
    "exec-on-event": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 0; pkill -SIGRTMIN+9 waybar",
    "return-type": "json",
    "interval": 1,
    "signal": 9,
    "hide-empty-text": true,
  },
  "custom/cookie-s1": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh slot 1",
    "exec-on-event": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 1; pkill -SIGRTMIN+9 waybar",
    "return-type": "json",
    "interval": 1,
    "signal": 9,
    "hide-empty-text": true,
  },
  "custom/cookie-s2": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh slot 2",
    "exec-on-event": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 2; pkill -SIGRTMIN+9 waybar",
    "return-type": "json",
    "interval": 1,
    "signal": 9,
    "hide-empty-text": true,
  },
  "custom/cookie-s3": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh slot 3",
    "exec-on-event": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 3; pkill -SIGRTMIN+9 waybar",
    "return-type": "json",
    "interval": 1,
    "signal": 9,
    "hide-empty-text": true,
  },
  "custom/cookie-s4": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh slot 4",
    "exec-on-event": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 4; pkill -SIGRTMIN+9 waybar",
    "return-type": "json",
    "interval": 1,
    "signal": 9,
    "hide-empty-text": true,
  },
  "custom/cookie-s5": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh slot 5",
    "exec-on-event": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 5; pkill -SIGRTMIN+9 waybar",
    "return-type": "json",
    "interval": 1,
    "signal": 9,
    "hide-empty-text": true,
  },
  "custom/cookie-s6": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh slot 6",
    "exec-on-event": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 6; pkill -SIGRTMIN+9 waybar",
    "return-type": "json",
    "interval": 1,
    "signal": 9,
    "hide-empty-text": true,
  },
  "custom/cookie-s7": {
    "exec": "$HOME/.config/waybar/cookie-clicker/run.sh slot 7",
    "exec-on-event": true,
    "on-click": "$HOME/.config/waybar/cookie-clicker/run.sh buy-slot 7; pkill -SIGRTMIN+9 waybar",
    "return-type": "json",
    "interval": 1,
    "signal": 9,
    "hide-empty-text": true,
  },
}
